  "linke": {"lemma":"linke","pos":"Adjektiv","forms":["linken","linkes"],"en":"left (side)","ur":"baayan","ex":{"de":"Das linke ist normal.","en":"The left one is normal.","ur":"Baayan normal hai."}},
