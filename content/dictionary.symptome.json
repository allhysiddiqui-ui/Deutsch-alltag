  "weit": {"lemma":"weit","pos":"Adjektiv","forms":["weite","weiten"],"en":"far; so weit = so far","ur":"door; so weit = ab tak","ex":{"de":"Alles klar so weit?","en":"All clear so far?","ur":"Ab tak sab theek?"}},
