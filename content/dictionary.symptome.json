  "denken": {"lemma":"denken","pos":"Verb","aux":"denkt / dachte / hat gedacht","forms":["denkt","dachte","gedacht"],"en":"to think","ur":"soch-na","ex":{"de":"Ich dachte eher an eine Allergie.","en":"I was rather thinking of an allergy.","ur":"Main allergy soch rahi thi."}},
