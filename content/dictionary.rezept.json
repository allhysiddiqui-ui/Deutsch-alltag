  "kostenlos": {"lemma":"kostenlos","pos":"Adjektiv","en":"free of charge","ur":"muft","ex":{"de":"Für Kinder ist das Medikament kostenlos.","en":"For children the medication is free.","ur":"Bachon ke liye dawa muft hai."}},
